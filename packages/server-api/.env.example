# Пример для packages/server-api (T-003). Скопировать в .env (в .gitignore) или экспортировать в окружение.

# PostgreSQL (TECH-SPEC 1). По умолчанию код использует локальный dev-кластер на 5433:
#   "C:/Program Files/PostgreSQL/18/bin/initdb.exe" -D .local/pgdata -A trust -U game_dev
#   "C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe" -D .local/pgdata -o "-p 5433 -c listen_addresses=127.0.0.1" -l .local/pg.log start
#   "C:/Program Files/PostgreSQL/18/bin/createdb.exe" -h 127.0.0.1 -p 5433 -U game_dev game_dev
DATABASE_URL=postgres://game_dev@127.0.0.1:5433/game_dev

# Секрет подписи JWT (HS256). Без него сервер генерирует временный — токены не переживут перезапуск.
JWT_SECRET=change-me-to-a-long-random-string

# Порт HTTP (0 = случайный свободный). 18080, т.к. 8080 на dev-машине занят другим сервисом.
PORT=18080

# Диагностическое логирование (TECH-SPEC 10.1, T-010). Без LOG_LEVEL уровень берётся
# из режима: info при NODE_ENV=production, иначе debug. pretty-вывод (pino-pretty)
# включён, когда NODE_ENV != production.
LOG_LEVEL=debug
# NODE_ENV=production
